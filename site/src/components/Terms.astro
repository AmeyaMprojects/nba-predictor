---
// The model's margin, term by term. Each bar grows from the centre toward the side it favours.
import type { Game } from '../lib/data';
import { modelSpread, TERM_LABELS, termText } from '../lib/format';
interface Props { game: Game }
const { game: g } = Astro.props;
const terms = g.terms!;
const scale = Math.max(8, ...TERM_LABELS.map(([k]) => Math.abs(terms[k] ?? 0)), Math.abs(g.spread ?? 0));
const w = (v: number) => Math.min(1, Math.abs(v) / scale) / 2;
---
<div class="terms">
  <p class="terms__axis" aria-hidden="true"><span>← {g.away_team}</span><span>{g.home_team} →</span></p>
  <dl>
    {TERM_LABELS.map(([k, label]) => {
      const v = terms[k] ?? 0;
      return (
        <div class="term">
          <dt>{label}</dt>
          <dd>
            <span class="term__bar" aria-hidden="true"><span class:list={['term__fill', v >= 0 ? 'is-home' : 'is-away']} style={`--w:${w(v)}`}></span></span>
            <span class="term__val">{termText(g, v)}</span>
          </dd>
        </div>
      );
    })}
    <div class="term term--total">
      <dt>Model margin</dt>
      <dd>
        <span class="term__bar" aria-hidden="true"><span class:list={['term__fill', (g.spread ?? 0) >= 0 ? 'is-home' : 'is-away']} style={`--w:${w(g.spread ?? 0)}`}></span></span>
        <span class="term__val">{modelSpread(g)}</span>
      </dd>
    </div>
  </dl>
</div>
